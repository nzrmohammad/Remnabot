# ==============================================================================
# REMNAWAVE TELEGRAM BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Get your bot token from @BotFather
BOT_TOKEN=123456789:ABCDefghIJKlmnoPQRstuvWXyz

# Numeric Telegram ID(s) of bot administrator(s).
# Can be a JSON array [123456789, 987654321] or comma-separated: 123456789, 987654321
ADMIN_IDS=[123456789]

# Numeric ID of your Admin Telegram Channel or Supergroup (used for receipts, logs, and alerts).
# Tip: Supergroup IDs are negative and usually start with -100 (e.g., -1001234567890).
ADMIN_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 2. ADMIN FORUM TOPIC ROUTING (OPTIONAL)
# ------------------------------------------------------------------------------
# If your ADMIN_CHAT_ID is a Supergroup with Topics/Forums enabled, specify thread/topic IDs:
# Leave empty if topics are not enabled or to send everything to the General topic.
ADMIN_TOPIC_TOPUPS=
ADMIN_TOPIC_ORDERS=
ADMIN_TOPIC_SUPPORT=
ADMIN_TOPIC_ALERTS=
ADMIN_TOPIC_CRYPTO=
ADMIN_TOPIC_ERRORS=

# ------------------------------------------------------------------------------
# 3. CRYPTO & DIRECT ON-CHAIN TON PAYMENTS (OPTIONAL)
# ------------------------------------------------------------------------------
# Enable or disable crypto deposit option for users (true / false)
CRYPTO_ENABLED=true

# Public TON wallet address (UQ... or EQ...) for receiving direct on-chain deposits
TON_WALLET_ADDRESS=UQAbCdEfGhIjKlMnOpQrStUvWxYz0123456789_abcdef

# Fixed/fallback TON exchange rate in Toman (used if auto-fetching is disabled or fails)
TON_RATE_TOMAN=400000

# Benchmark Tether (USDT) rate in Toman for global pricing (Binance/TonAPI TON/USD * USDT)
# Default is 95000 Toman. Adjust according to current free-market rates.
USDT_RATE_TOMAN=95000

# Optional HTTP/SOCKS5 proxy for querying Iranian domestic exchanges (Nobitex, Bitpin, etc.)
# from foreign VPS servers (e.g., http://user:pass@iran-proxy.com:8080)
# Leave empty to use global fallback (Binance / TonAPI / CoinGecko) automatically.
IRAN_PROXY=

# ------------------------------------------------------------------------------
# 4. CARD-TO-CARD WALLET TOP-UP (OPTIONAL)
# ------------------------------------------------------------------------------
# Bank card number for manual card-to-card deposits (leave empty to disable card deposits)
CARD_NUMBER=6037-9917-1234-5678

# Cardholder name displayed to users during deposit
CARD_HOLDER=John Doe

# Minimum deposit amount in Toman (default: 10,000)
TOPUP_MIN_AMOUNT=10000

# ------------------------------------------------------------------------------
# 5. REMNAWAVE PANEL CONNECTION (REQUIRED)
# ------------------------------------------------------------------------------
# Base URL of your Remnawave Panel (without trailing slash).
# If running on the same server via Docker: use your domain or http://host.docker.internal:3000
REMNAWAVE_BASE_URL=https://panel.example.com

# API Token generated inside your Remnawave Panel (Admin -> API Tokens)
REMNAWAVE_TOKEN=your_remnawave_api_token_here

# ------------------------------------------------------------------------------
# 6. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL async connection string.
# When using default docker-compose.yml, this matches the internal db container.
DATABASE_URL=postgresql+asyncpg://remnabot:remnabot@localhost:5432/remnabot

# ------------------------------------------------------------------------------
# 7. OPTIONAL INFRASTRUCTURE & LIFECYCLE
# ------------------------------------------------------------------------------
# Timezone for usage statistics and daily/weekly/monthly reports (default: Asia/Tehran)
TIMEZONE=Asia/Tehran

# Production FSM Storage: Uncomment to use Redis for persistent user state across restarts.
# When empty, MemoryStorage is used automatically.
# REDIS_URL=redis://localhost:6379/0

# Sentry Error Tracking DSN (Optional - leave empty to disable)
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 8. TELEGRAM MINI APP (TMA) & WEB SERVER (OPTIONAL)
# ------------------------------------------------------------------------------
# Enable or disable the internal async TMA web server (default: true)
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Public HTTPS URL of the WebApp (e.g. https://app.yourdomain.com)
# When set, the bot automatically adds "📱 داشبورد کاربری من" in the main menu
# and "👑 پنل وب کلاستر" for administrators.
# Leave empty during initial local development.
WEB_APP_URL=