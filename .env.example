# ==============================================================================
# REMNAWAVE TELEGRAM BOT - CONFIGURATION
# ==============================================================================

# 1. TELEGRAM BOT (REQUIRED)
# ------------------------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456789:ABCDefghIJKlmnoPQRstuvWXyz

# Admin Telegram ID(s): single ID, comma-separated (111, 222), or JSON array [111, 222]
ADMIN_IDS=123456789

# Admin Channel / Supergroup ID for alerts and notifications (starts with -100)
ADMIN_CHAT_ID=-1001234567890

# 2. REMNAWAVE PANEL (REQUIRED)
# ------------------------------------------------------------------------------
# Panel URL without trailing slash
REMNAWAVE_BASE_URL=https://panel.example.com

# API Token created in Remnawave Panel (Admin -> API Tokens)
REMNAWAVE_TOKEN=your_remnawave_api_token_here

# 3. DATABASE (REQUIRED)
# ------------------------------------------------------------------------------
# For Docker Compose deployments (default), use the service container hostname 'db':
DATABASE_URL=postgresql+asyncpg://remnabot:remnabot@db:5432/remnabot
# For Local / Native development outside Docker (e.g. running on Windows/Linux host directly):
# DATABASE_URL=postgresql+asyncpg://remnabot:remnabot@localhost:5432/remnabot

# 4. OPTIONAL INFRASTRUCTURE & TELEGRAM MINI APP (TMA)
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Tehran

# Public HTTPS URL of your Telegram Mini App (e.g. https://app.yourdomain.com)
# When set, the bot automatically registers inline dashboard buttons and menu shortcuts.
# WEB_APP_URL=https://app.yourdomain.com

# Production FSM Storage (Redis):
# For Docker Compose deployments, use the service container hostname 'redis':
# REDIS_URL=redis://:remnabot_redis_secret@redis:6379/0
# For Local / Native development outside Docker:
# REDIS_URL=redis://:remnabot_redis_secret@localhost:6379/0

# Optional proxy for querying domestic Iranian crypto exchanges from a foreign VPS
# IRAN_PROXY=http://user:pass@iran-proxy.com:8080

# External Remnawave Docker network name (default: remnawave-network)
# If Remnawave runs on a differently named docker network, specify it here:
# REMNAWAVE_DOCKER_NETWORK=remnawave-network
